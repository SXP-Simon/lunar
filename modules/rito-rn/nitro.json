{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "ritonitro"
  ],
  "ios": {
    "iosModuleName": "RitoNitro"
  },
  "android": {
    "androidNamespace": [
      "ritonitro"
    ],
    "androidCxxLibName": "RitoNitro"
  },
  "autolinking": {
    "RitoNitro": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridRitoNitro"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}