{
  "name": "@lunar/plugin-sdk",
  "version": "0.1.0",
  "description": "Public contract for Lunar reader plugins.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui.ts",
    "./manifest": "./src/manifest.ts",
    "./package-format": "./src/package-format.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "~6.0.3",
    "vitest": "3.2.4"
  }
}
