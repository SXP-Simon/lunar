{
  "cli": {
    "version": ">= 21.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "LUNAR_ANDROID_COMPACT_DEV_BUILD": "true",
        "LUNAR_ANDROID_ABIS": "arm64-v8a"
      },
      "android": {
        "image": "sdk-57",
        "gradleCommand": ":app:assembleDebugOptimized"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "release": {
      "extends": "production",
      "environment": "production",
      "distribution": "internal",
      "developmentClient": false,
      "credentialsSource": "remote",
      "env": {
        "LUNAR_ANDROID_ABIS": "arm64-v8a"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
